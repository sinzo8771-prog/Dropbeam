{
  "name": "Dropbeam",
  "short_name": "Dropbeam",
  "description": "Send files straight between your devices. Nothing is uploaded.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"],
          "multiple": true
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Send to this device",
      "short_name": "Send",
      "description": "Pair a device and send what you shared.",
      "url": "./?screen=send",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Test my connection",
      "short_name": "Self-test",
      "description": "Check that this browser can open direct connections.",
      "url": "./?screen=selftest",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "background_color": "#F6F2EA",
  "theme_color": "#F6F2EA",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
